# Revalidate the shell, service worker, and manifest so a deploy can replace them.
# Hashed files under /assets/ keep their own cache; the service worker tracks revisions.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json
